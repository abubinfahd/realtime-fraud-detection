# ==============================================================================
# Stage 1: Builder — Resolve & install dependencies using uv
# ==============================================================================
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.6.3 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

RUN uv sync --frozen --no-dev --no-editable

# ==============================================================================
# Stage 2: Runtime — Production ASGI image for FastAPI Gateway & Dashboard
# ==============================================================================
FROM python:3.12-slim AS runtime

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/src" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Install libgomp1 for LightGBM direct /predict endpoint support
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* && \
    groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -m -s /sbin/nologin appuser && \
    mkdir -p /app/artifacts && chown -R appuser:appgroup /app/artifacts

# Copy virtual environment, application source, dashboard static assets, and model
COPY --from=builder --chown=appuser:appgroup /app/.venv /app/.venv
COPY --chown=appuser:appgroup src ./src
COPY --chown=appuser:appgroup scripts ./scripts
COPY --chown=appuser:appgroup dashboard ./dashboard
COPY --chown=appuser:appgroup artifacts/fraud_model.joblib ./artifacts/fraud_model.joblib

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/livez')"]

ENTRYPOINT ["python", "scripts/run_gateway.py"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
